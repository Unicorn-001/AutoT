[Unit]
Description=AutoT daily-scanner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=autot
Group=autot
WorkingDirectory=/opt/autot
EnvironmentFile=/etc/autot/autot.env
ExecStartPre=/opt/autot/venv/bin/python -m autot.ops validate --service scanner
ExecStart=/opt/autot/venv/bin/python -m autot.daily_scanner
Restart=on-failure
RestartSec=15
TimeoutStopSec=600
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
