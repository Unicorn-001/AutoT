AUTOT_DATA_DIR=/var/lib/autot
PYTHONUNBUFFERED=1
# Keep backups outside live data; provision this directory for the autot user.
AUTOT_BACKUP_DIR=/var/backups/autot
# eToro V1: demo only. Set credentials in the service environment, never SQLite.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_TRADING_MODE=demo
ETORO_TIMEOUT_SECONDS=10
ETORO_MAX_RETRIES=2
